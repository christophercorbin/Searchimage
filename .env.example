# Environment Configuration
# Copy this file to .env and fill in actual values
# NEVER commit .env to git

# Application Environment
ENV=dev
FLOW=quick

# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=YOUR_AWS_ACCOUNT_ID

# Kafka Configuration (Event Streaming)
KAFKA_SERVERS=b-1.protexxadev.78kot0.c12.kafka.us-east-1.amazonaws.com:9092
KAFKA_CONSUMER_GROUP=dme-searcher_group
KAFKA_TOPIC_IN=dme-searcher-dev
KAFKA_TOPIC_OUT=dme-detector-dev
KAFKA_SECURITY_PROTOCOL=PLAINTEXT

# MongoDB Configuration (fetched from Secrets Manager at runtime)
# DO NOT hardcode MongoDB URLs here
# They are retrieved from AWS Secrets Manager
MONGO_SECRETS_NAME=dev/mongodb

# AWS OpenSearch (Vector Database)
OPENSEARCH_HOST=z04opduo9ov5uvfz398a.us-east-1.aoss.amazonaws.com
OPENSEARCH_REGION=us-east-1
OPENSEARCH_INDEX=idx_face

# AWS S3 Configuration
USER_IMAGE_STORAGE_BUCKET=dme-user-image-4242
WEB_IMAGE_STORAGE_BUCKET=dme-web-image-4242

# AWS SageMaker (ML Inference)
SAGEMAKER_ENDPOINT=defenderImageAnalyzerEndpointC5i
SAGEMAKER_REGION=us-east-1
MAX_GPU_MEMORY_GB=1

# Google Serper API (Web Search)
# IMPORTANT: Use AWS Secrets Manager in production, not environment variables
SERPER_API_KEY=YOUR_API_KEY_FROM_SECRETS_MANAGER

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=json

# Feature Flags
PURGE_SCRAPPED_DATA=true
ENABLE_FACE_MATCHING=true
